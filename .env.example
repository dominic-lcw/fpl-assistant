# Required: Google AI Studio API key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: Gemini model — flash | pro | or a full model id (default: gemini-2.5-flash)
GEMINI_MODEL=flash

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client (Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only this Google account may sign in (exact email match)
ALLOWED_EMAIL=you@gmail.com

# Local: http://localhost:3000
# Cloud Run: https://YOUR-SERVICE-xxxxx.run.app (or rely on AUTH_TRUST_HOST=true)
# AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Development only: skip Google sign-in so you can preview the UI locally.
# Never set this in production.
# AUTH_BYPASS=true
