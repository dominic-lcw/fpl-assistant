# Required: Moonshot / Kimi API key from https://platform.kimi.ai
MOONSHOT_API_KEY=

# Optional: default Kimi model when the client does not send one.
# Allowed: kimi-k3 | kimi-k2.7-code (default: kimi-k3)
# Users can also switch models in the chat composer UI.
KIMI_MODEL=kimi-k3

# $web_search uses Kimi's built-in search (builtin_function) with the same
# MOONSHOT_API_KEY as chat — no separate search product/key.

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client (Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# PostgreSQL — use the same Cloud SQL instance for local + Cloud Run.
#
# Local (via Cloud SQL Auth Proxy on port 5432):
#   1. In another terminal: pnpm db:proxy
#   2. DATABASE_URL below (password = the Cloud SQL DB user password)
DATABASE_URL=postgresql://fpl_assistant:YOUR_DB_PASSWORD@127.0.0.1:5432/fpl_assistant
#
# Cloud Run (Unix socket via Cloud SQL connector; store in Secret Manager):
# DATABASE_URL=postgresql://fpl_assistant:YOUR_DB_PASSWORD@/fpl_assistant?host=/cloudsql/openclaw-dominic-209:asia-southeast1:fpl-assistant-db

# Comma-separated Google accounts that bootstrap as approved administrators.
# All other first-time sign-ins are created with pending access.
ADMIN_EMAILS=you@gmail.com

# Local: http://localhost:3000
# Cloud Run: https://YOUR-SERVICE-xxxxx.run.app (or rely on AUTH_TRUST_HOST=true)
# AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Development only: skip Google sign-in so you can preview the UI locally.
# Never set this in production.
# AUTH_BYPASS=true
