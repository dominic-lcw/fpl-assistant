# Required: Moonshot / Kimi API key from https://platform.kimi.ai
MOONSHOT_API_KEY=

# Optional: override the default Kimi model (default: kimi-k3)
KIMI_MODEL=kimi-k3

# Optional: Moonshot API base (default: https://api.moonshot.ai/v1)
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# web_search uses Moonshot's official Formula tool: moonshot/web-search:latest
# (same MOONSHOT_API_KEY as chat; no separate search key required)

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client (Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only this Google account may sign in (exact email match)
ALLOWED_EMAIL=you@gmail.com

# Local: http://localhost:3000
# Cloud Run: https://YOUR-SERVICE-xxxxx.run.app (or rely on AUTH_TRUST_HOST=true)
# AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Development only: skip Google sign-in so you can preview the UI locally.
# Never set this in production.
# AUTH_BYPASS=true
