# Required: Moonshot / Kimi API key from https://platform.kimi.ai
MOONSHOT_API_KEY=

# Optional: default Kimi model when the client does not send one.
# Allowed: kimi-k3 | kimi-k2.7-code (default: kimi-k3)
# Users can also switch models in the chat composer UI.
KIMI_MODEL=kimi-k3

# $web_search uses Kimi's built-in search (builtin_function) with the same
# MOONSHOT_API_KEY as chat — no separate search product/key.

# Reddit API — required only for the community listing tool. Create a Reddit
# app and use a descriptive User-Agent, for example:
# fpl-assistant/0.1 by u/your_reddit_username
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client (Cloud Console → APIs & Services → Credentials)
# OAuth stays with Google even when the app is hosted on Azure.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# PostgreSQL — Azure Database for PostgreSQL Flexible Server (local + Container Apps).
#
# 1. Allow your IP: pnpm db:allow-ip
# 2. Use sslmode=require (mandatory on Flexible Server)
DATABASE_URL=postgresql://fpl_assistant:YOUR_DB_PASSWORD@fpl-assistant-pg.postgres.database.azure.com:5432/fpl_assistant?sslmode=require

# Optional: used by scripts/azure/provision.sh if you prefer not to export DB_PASSWORD
# DB_PASSWORD=

# Comma-separated Google accounts that bootstrap as approved administrators.
# All other first-time sign-ins are created with pending access.
ADMIN_EMAILS=you@gmail.com

# Local: http://localhost:3000
# Azure Container Apps: https://YOUR-APP.REGION.azurecontainerapps.io
# AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Development only: skip Google sign-in so you can preview the UI locally.
# Never set this in production.
# AUTH_BYPASS=true
