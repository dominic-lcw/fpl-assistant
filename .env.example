# Required: Azure AI Foundry / Azure OpenAI credentials
# Use either AZURE_RESOURCE_NAME or a full endpoint (AZURE_BASE_URL / AZURE_OPENAI_ENDPOINT).
AZURE_API_KEY=
AZURE_RESOURCE_NAME=
# AZURE_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1
# AZURE_OPENAI_API_KEY=   # alias for AZURE_API_KEY

# Optional: default model when the UI does not send one.
# Allowed: gpt-5.6-luna | gpt-5.6-terra | gpt-5.6-sol (default: gpt-5.6-terra)
# Users can also switch models in the chat composer UI.
AZURE_MODEL=gpt-5.6-terra

# Optional: override Azure deployment names when they differ from the catalog ids.
# AZURE_DEPLOYMENT_LUNA=gpt-5.6-luna
# AZURE_DEPLOYMENT_TERRA=gpt-5.6-terra
# AZURE_DEPLOYMENT_SOL=gpt-5.6-sol

# web_search uses Azure Foundry Responses API grounding (Bing) with the same
# Azure chat credentials — no separate search product/key.

# Reddit API — required only for the community listing tool. Create a Reddit
# app and use a descriptive User-Agent, for example:
# fpl-assistant/0.1 by u/your_reddit_username
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client (Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# PostgreSQL — use the same Cloud SQL instance for local + Cloud Run.
#
# Local (via Cloud SQL Auth Proxy on port 5432):
#   1. In another terminal: pnpm db:proxy
#   2. DATABASE_URL below (password = the Cloud SQL DB user password)
DATABASE_URL=postgresql://fpl_assistant:YOUR_DB_PASSWORD@127.0.0.1:5432/fpl_assistant
#
# Cloud Run (Unix socket via Cloud SQL connector; store in Secret Manager):
# DATABASE_URL=postgresql://fpl_assistant:YOUR_DB_PASSWORD@/fpl_assistant?host=/cloudsql/openclaw-dominic-209:asia-southeast1:fpl-assistant-db

# Comma-separated Google accounts that bootstrap as approved administrators.
# All other first-time sign-ins are created with pending access.
ADMIN_EMAILS=you@gmail.com

# Local: http://localhost:3000
# Cloud Run: https://YOUR-SERVICE-xxxxx.run.app (or rely on AUTH_TRUST_HOST=true)
# AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Development only: skip Google sign-in so you can preview the UI locally.
# Never set this in production.
# AUTH_BYPASS=true
